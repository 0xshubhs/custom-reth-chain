# Copy to .env (or run scripts/setup-network.sh, which writes it for you).
# Every value here is optional; the defaults run a local development chain.

# ---- Which files make up the stack -----------------------------------------
# Development chain (default):   COMPOSE_FILE=compose.yaml
# Real network (after setup):    COMPOSE_FILE=compose.yaml:compose.live.yaml
COMPOSE_FILE=compose.yaml
COMPOSE_PROJECT_NAME=meowchain

# ---- Network identity (shown by the explorer and wallets) ------------------
NETWORK_NAME=Meowchain
NATIVE_SYMBOL=ETH
# 0 = read it from the node.
CHAIN_ID=0

# ---- Chain node --------------------------------------------------------------
# true: seal a block only when a transaction arrives. false: one every block
# period (1 s on the development chain, block_period in network.toml).
CHAIN_EAGER_MINING=true
CHAIN_LOG=info
# The node's full RPC, for apps on this host. Keep it on 127.0.0.1.
CHAIN_BIND_ADDRESS=127.0.0.1
CHAIN_HTTP_PORT=8545
CHAIN_WS_PORT=8546
# Browser origins allowed to call the node directly (the explorer's "write contract").
CHAIN_CORS=http://localhost:3000
# Real network only: this node's signer key file (hex), mounted as a docker secret.
SIGNER_KEY_PATH=./secrets/signer.key

# ---- Public addresses ----------------------------------------------------------
# Where people reach the explorer and the public RPC. Baked into the website at
# build time: rebuild explorer-web after changing them.
EXPLORER_PUBLIC_URL=http://localhost:3000
PUBLIC_RPC_URL=http://localhost:8548

# ---- Published ports -------------------------------------------------------------
# 127.0.0.1 keeps everything private to this host; put a TLS proxy in front.
BIND_ADDRESS=127.0.0.1
EXPLORER_WEB_PORT=3000
EXPLORER_API_PORT=4000
RPC_GATEWAY_PORT=8548

# ---- Public RPC gateway ----------------------------------------------------------
# Comma-separated browser origins allowed to call the public RPC (your sites).
RPC_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RPC_GATEWAY_RATE_PER_IP=

# ---- Explorer ----------------------------------------------------------------------
# To explore another chain instead of the bundled node, run explorer/compose.yaml
# alone with these pointing at its RPC.
CHAIN_RPC_URL=http://chain:8545
CHAIN_WS_URL=ws://chain:8546
# auto: index call traces when the node serves debug_traceBlockByNumber.
# required: refuse to run without them. off: never ask.
TRACES=auto
EXPLORER_DB_NAME=explorer
EXPLORER_DB_USER=explorer
# Change this for anything that is not a laptop.
EXPLORER_DB_PASSWORD=explorer
# Shared secret for the node-to-indexer new-block hook (optional).
INDEXER_HOOK_TOKEN=
# on: the verifier fetches any solc release (sha256-checked). off: bundled only.
SOLC_DOWNLOAD=on
RATE_LIMIT_PER_MIN=240
VERIFY_LIMIT_PER_HOUR=20
CALL_LIMIT_PER_MIN=60
EXPLORER_LOG_LEVEL=info
EXPLORER_CSP_MODE=enforce
